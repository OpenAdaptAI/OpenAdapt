{
  "_comment": [
    "Install-weight budgets, enforced by scripts/install_weight/weigh.py check in CI (packages.yml, install-weight).",
    "Each package is built from this tree and installed alone with Python 3.12. allow lists every distribution",
    "the install may pull (fnmatch patterns; macOS and Linux sets); forbid always fails, even if allow matches.",
    "max_mb is the size of site-packages, set from the x86_64 CI measurement (larger wheels than arm64) plus about 20 percent.",
    "To change one, see docs/monorepo/INSTALL_WEIGHT.md. privacy and desktop fall back to PyPI until their",
    "directories exist in packages/."
  ],
  "python": "3.12",
  "defaults": {
    "forbid": [
      "torch",
      "torch-*",
      "torchvision",
      "tensorflow*",
      "jax",
      "jaxlib"
    ]
  },
  "packages": {
    "types": {
      "path": "packages/types",
      "module": "openadapt_types",
      "max_mb": 15,
      "max_dists": 8,
      "forbid": [
        "openadapt-flow",
        "openadapt-desktop",
        "openadapt-capture",
        "openadapt-agent",
        "openadapt",
        "opencv-*",
        "onnxruntime*",
        "rapidocr*",
        "playwright",
        "matplotlib",
        "numpy",
        "openadapt-privacy"
      ],
      "allow": [
        "annotated-types",
        "openadapt-types",
        "pydantic",
        "pydantic-core",
        "typing-extensions",
        "typing-inspection"
      ]
    },
