# openadapt-capture reads configuration from environment variables or this file.
#
# Recording and transcription work without any API key, and no configuration
# causes a capture to be uploaded. Audio narration is transcribed on this
# machine only; install an on-device backend with:
#
#     pip install "openadapt-capture[transcribe-fast]"   # faster-whisper
#     pip install "openadapt-capture[transcribe]"        # openai-whisper
#
# Microphone narration is off by default. Enabling it retains what the
# demonstrator says aloud as transcript text.
# RECORD_AUDIO=false
#
# Retaining the raw waveform additionally keeps biometric voice data in the
# capture database. A waveform has no sanitized derivative and can never be
# cleared for egress, so this stays off unless you have a specific reason.
# RECORD_AUDIO_RETAIN_WAVEFORM=false
