       "each_item",
       "problems_only",
       "not_gated"
      ],
      "title": "ApprovalMode",
      "type": "string"
     },
     "ApproverAuth": {
      "enum": [
       "cloud_user",
       "unauthenticated",
       "policy",
       "local_cli",
       "signed_webhook",
       "mcp_session"
      ],
      "title": "ApproverAuth",
      "type": "string"
     },
     "ApproverIdentityV1": {
      "additionalProperties": false,
      "description": "Mirror of ``openadapt_types.ApproverIdentityV1``.",
      "properties": {
       "schema_version": {
        "const": "openadapt.approver-identity/v1",
        "default": "openadapt.approver-identity/v1",
        "title": "Schema Version",
        "type": "string"
       },
       "kind": {
        "$ref": "#/$defs/ApproverKind"
       },
       "auth": {
        "$ref": "#/$defs/ApproverAuth"
       },
       "id": {
        "anyOf": [
         {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,255}$",
          "type": "string"
         },
         {
          "type": "null"
         }
        ],
        "default": null,
        "title": "Id"
       },
       "auth_method": {
        "default": "none",
        "enum": [
         "cloud_aal2",
         "cloud_aal1",
         "none"
        ],
        "title": "Auth Method",
        "type": "string"
       },
       "policy_ref": {
        "anyOf": [
         {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
         },
         {
          "type": "null"
         }
        ],
        "default": null,
        "title": "Policy Ref"
       },
       "on_behalf_of": {
        "anyOf": [
         {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,255}$",
          "type": "string"
         },
         {
          "type": "null"
         }
        ],
        "default": null,
        "title": "On Behalf Of"
       }
      },
      "required": [
       "kind",
       "auth"
      ],
      "title": "ApproverIdentityV1",
      "type": "object"
     },
     "ApproverKind": {
      "enum": [
       "person",
       "rule",
       "agent",
       "system"
      ],
      "title": "ApproverKind",
      "type": "string"
     },
     "CheckOutcome": {
      "additionalProperties": false,
      "description": "The result of one named check, with a closed-vocabulary detail code.",
      "properties": {
       "code": {
        "enum": [
         "channel",
         "inputs_strict",
         "inputs_supplied",
         "not_a_retry",
         "record_key_not_recent",
         "deployment_config",
         "switch_lease",
         "not_resumed",
         "switch_on",
         "signed_in_user",
         "right_record",
         "same_screens",
         "record_check_ready",
         "verified",
         "whole_run_clean",
         "each_item",
         "gate_error",
         "switch_log",
         "dry_run"
        ],
        "title": "Code",
        "type": "string"
       },
       "passed": {
        "title": "Passed",
        "type": "boolean"
       },
       "detail": {
        "default": "ok",
        "pattern": "^[a-z][a-z0-9_]{0,63}$",
        "title": "Detail",
        "type": "string"
       },
       "step_id": {
        "anyOf": [
         {
          "maxLength": 256,
          "type": "string"
         },
         {
          "type": "null"
         }
        ],
        "default": null,
        "title": "Step Id"
       }
      },
      "required": [
       "code",
       "passed"
      ],
      "title": "CheckOutcome",
      "type": "object"
     },
     "ItemApprovalRef": {
      "additionalProperties": false,
      "description": "One person's answer to one item-approval request, as PHI-free codes.\n\nThe approver is a Cloud user id (never a name), or ``unauthenticated``\nwhen the person approved in Desktop while signed out. Digests bind the\nexact request the person saw and the exact answer file.",
      "properties": {
       "step_id": {
        "maxLength": 256,
        "minLength": 1,
        "title": "Step Id",
        "type": "string"
       },
       "request_sha256": {
        "pattern": "^sha256:[0-9a-f]{64}$",
        "title": "Request Sha256",
        "type": "string"
       },
       "answer_sha256": {
        "pattern": "^sha256:[0-9a-f]{64}$",
        "title": "Answer Sha256",
        "type": "string"
       },
       "decision": {
        "enum": [
         "approved",
         "declined"
        ],
        "title": "Decision",
        "type": "string"
       },
       "decline_reason": {
        "anyOf": [
         {
          "enum": [
           "wrong_values",
           "wrong_record",
           "screen_problem"
          ],
          "type": "string"
         },
         {
          "type": "null"
         }
        ],
        "default": null,
        "title": "Decline Reason"
       },
       "decided_by": {
        "default": "human",
        "enum": [
         "human",
         "automation"
        ],
        "title": "Decided By",
        "type": "string"
       },
       "route": {
        "default": "desktop_run_it",
        "enum": [
         "desktop_run_it",
         "decision_portal",
         "local_cli",
         "webhook",
         "mcp"
