{
  "manifest_version": 3,
  "name": "OpenAdapt Extension Evidence (optional)",
  "version": "0.1.0",
  "description": "Optional everyday-Chrome evidence for OpenAdapt recordings: open shadow DOM targets while a recording is active. Not required; accessibility recording still works without it.",
  "permissions": [
    "activeTab",
    "tabs",
    "scripting",
    "storage",
    "nativeMessaging"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "OpenAdapt extension evidence (idle)"
  }
}
