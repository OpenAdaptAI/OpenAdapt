{
  "$defs": {
    "BundleMeta": {
      "description": "Bundle-level summary shown in the visualization header.",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "schema_version": {
          "title": "Schema Version",
          "type": "integer"
        },
        "created_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Created At"
        },
        "viewport": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "integer"
                },
                {
                  "type": "integer"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Viewport"
        },
        "is_program": {
          "default": false,
          "description": "True when a Phase-2 ProgramGraph is present (branches/loops); False for a linear step list.",
          "title": "Is Program",
          "type": "boolean"
        },
        "is_composition": {
          "default": false,
          "description": "True when this graph is a parent sequencer of child bundles, not a Workflow or a ProgramGraph.",
          "title": "Is Composition",
          "type": "boolean"
        },
        "composition_schema": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Composition artifact schema id when is_composition is True.",
          "title": "Composition Schema"
        },
        "contains_phi": {
          "default": false,
          "title": "Contains Phi",
          "type": "boolean"
        },
        "phi_scrubbed": {
          "default": false,
          "title": "Phi Scrubbed",
          "type": "boolean"
        },
        "encrypted": {
          "default": false,
          "title": "Encrypted",
          "type": "boolean"
        },
        "step_count": {
          "default": 0,
          "title": "Step Count",
          "type": "integer"
        },
        "action_count": {
          "default": 0,
          "title": "Action Count",
          "type": "integer"
        },
        "irreversible_count": {
          "default": 0,
          "title": "Irreversible Count",
          "type": "integer"
        },
        "identity_armed_count": {
          "default": 0,
          "title": "Identity Armed Count",
          "type": "integer"
        },
        "identity_unarmed_count": {
          "default": 0,
          "title": "Identity Unarmed Count",
          "type": "integer"
        },
        "effect_count": {
          "default": 0,
          "title": "Effect Count",
          "type": "integer"
        },
        "api_binding_count": {
          "default": 0,
          "title": "Api Binding Count",
          "type": "integer"
        },
        "halt_point_count": {
          "default": 0,
          "title": "Halt Point Count",
          "type": "integer"
        },
        "child_count": {
          "default": 0,
          "title": "Child Count",
          "type": "integer"
        },
        "params": {
          "items": {
            "$ref": "#/$defs/ParamInfo"
          },
          "title": "Params",
          "type": "array"
        },
        "provenance": {
          "$ref": "#/$defs/ProvenanceInfo"
        }
      },
      "required": [
        "name",
        "schema_version"
      ],
      "title": "BundleMeta",
      "type": "object"
    },
    "EdgeKind": {
      "description": "Kind of graph edge. ``sequence`` is the unconditional next-step edge of a\nlinear program or the composition ``--after`` DAG; ``branch`` is a guarded\ntransition; ``exception`` routes a failed action to a handler;\n``loop_body`` links a loop node to its per-row body; ``handoff`` carries\neffect-bound parameter names between child bundles.",
      "enum": [
        "sequence",
        "branch",
        "exception",
        "loop_body",
        "handoff"
      ],
      "title": "EdgeKind",
      "type": "string"
    },
    "EffectInfo": {
      "description": "One declared system-of-record effect on a node -- what must be true of\nthe REAL record for the step to have actually succeeded (verified after the\naction; a non-confirmed verdict HALTs).",
      "properties": {
        "kind": {
          "description": "record_written | field_equals",
          "title": "Kind",
          "type": "string"
        },
        "summary": {
          "description": "Short human description of the effect contract",
          "title": "Summary",
          "type": "string"
        },
        "risk": {
          "default": "reversible",
          "title": "Risk",
          "type": "string"
        },
        "needs_operator_confirmation": {
          "default": false,
          "description": "Placeholder effect: binding not derivable from the demo; HALTs until bound",
          "title": "Needs Operator Confirmation",
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "summary"
      ],
      "title": "EffectInfo",
      "type": "object"
    },
    "GraphEdge": {
      "description": "A directed edge between two nodes.",
      "properties": {
        "source": {
          "title": "Source",
          "type": "string"
        },
        "target": {
          "title": "Target",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/EdgeKind",
          "default": "sequence"
        },
        "label": {
          "default": "",
          "title": "Label",
          "type": "string"
        },
        "guard": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Guard summary for a branch edge",
          "title": "Guard"
        },
        "guard_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The scrubbed spoken sentence that suggested this branch",
          "title": "Guard Reason"
        }
      },
      "required": [
        "source",
        "target"
      ],
      "title": "GraphEdge",
      "type": "object"
    },
    "GraphNode": {
      "description": "A node in the program graph. A compiled step projects to an ``action``\nnode; a Phase-2 program state projects to its matching kind.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "index": {
          "description": "0-based order in the program (for layout)",
          "title": "Index",
          "type": "integer"
        },
        "kind": {
          "$ref": "#/$defs/NodeKind",
          "default": "action"
        },
        "title": {
          "description": "Human-readable intent / purpose",
          "title": "Title",
          "type": "string"
        },
        "action": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "click|type|key|wait|scroll",
          "title": "Action"
        },
        "risk": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "reversible|irreversible",
          "title": "Risk"
        },
        "risk_explanation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Risk Explanation"
        },
        "risk_review_required": {
          "default": false,
          "title": "Risk Review Required",
          "type": "boolean"
        },
        "param": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Bound run parameter, if any",
          "title": "Param"
        },
        "secret": {
          "default": false,
          "description": "Types a secret (never stored)",
          "title": "Secret",
          "type": "boolean"
        },
        "key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Key for a KEY action",
          "title": "Key"
        },
        "resolution": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResolutionInfo"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "identity": {
          "anyOf": [
            {
              "$ref": "#/$defs/IdentityInfo"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "effects": {
          "items": {
            "$ref": "#/$defs/EffectInfo"
          },
          "title": "Effects",
          "type": "array"
        },
        "has_api_binding": {
          "default": false,
          "title": "Has Api Binding",
          "type": "boolean"
        },
        "api_summary": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Api Summary"
        },
        "postconditions": {
          "description": "Vision postcondition kinds checked after the action",
          "items": {
            "type": "string"
          },
          "title": "Postconditions",
          "type": "array"
        },
        "guard": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Precondition summary, if guarded",
          "title": "Guard"
        },
        "guard_on_unmet": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "halt|skip when guard unmet",
          "title": "Guard On Unmet"
        },
        "guard_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The scrubbed spoken sentence that suggested this guard",
          "title": "Guard Reason"
        },
        "guard_certified_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "recordings_agree|probe|person: what certified a narrated guard",
          "title": "Guard Certified By"
        },
        "wait_until": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Readiness predicate summary",
          "title": "Wait Until"
        },
        "outcome": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "success|halt|escalate",
          "title": "Outcome"
        },
        "reason": {
          "default": "",
          "title": "Reason",
          "type": "string"
        },
        "halts": {
          "items": {
            "type": "string"
          },
          "title": "Halts",
          "type": "array"
        },
        "badges": {
          "items": {
            "type": "string"
          },
          "title": "Badges",
          "type": "array"
        },
        "media": {
          "anyOf": [
            {
              "$ref": "#/$defs/NodeMedia"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "References to recorded pictures of the step; never image data"
        },
        "surface": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Recorded execution surface of a child bundle (web|windows|macos|linux|rdp|citrix)",
          "title": "Surface"
        }
      },
      "required": [
        "id",
        "index",
        "title"
      ],
      "title": "GraphNode",
      "type": "object"
    },
    "GraphSection": {
      "description": "A named, contiguous group of action nodes, compiled with the bundle.\n\nDisplay metadata from the bundle's ``sections.json``: a surface may fold\na section into one card. Execution never reads it.",
      "properties": {
        "id": {
          "description": "Section id; never equal to a node id",
          "title": "Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "subtitle": {
          "description": "One line such as '6 steps \u00b7 3 fields'",
          "title": "Subtitle",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/SectionKind"
        },
        "title_source": {
          "$ref": "#/$defs/SectionTitleSource"
        },
        "nodes": {
          "description": "Member node ids, in program order",
          "items": {
            "type": "string"
          },
          "title": "Nodes",
          "type": "array"
        },
        "section": {
          "description": "The bundle's section id, for review edits",
          "title": "Section",
          "type": "string"
        },
        "steps": {
          "description": "The members' step ids, parallel to nodes",
          "items": {
            "type": "string"
          },
          "title": "Steps",
          "type": "array"
        },
        "fields": {
          "description": "Readable names of the fields it fills",
          "items": {
            "type": "string"
          },
          "title": "Fields",
          "type": "array"
        }
      },
      "required": [
        "id",
        "title",
        "subtitle",
        "kind",
        "title_source",
        "nodes",
        "section",
        "steps"
      ],
      "title": "GraphSection",
      "type": "object"
    },
    "IdentityInfo": {
      "description": "The pre-action identity gate for a click / anchored-type node -- the\nwrong-record guard's compile-time coverage.\n\n``armed`` is True when the gate will verify the target's identity band\nbefore acting, False when the step will act WITHOUT identity verification\n(``reason`` says why it compiled unarmed), and None when identity does not\napply to this node. ``phi_free`` is True when identity is carried as a\nsalted-hash template rather than a plaintext band.",
      "properties": {
        "applicable": {
          "default": false,
          "description": "Does an identity gate apply?",
          "title": "Applicable",
          "type": "boolean"
        },
        "armed": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Is the gate armed?",
          "title": "Armed"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Why the step compiled unarmed (if unarmed)",
          "title": "Reason"
        },
        "phi_free": {
          "default": false,
          "description": "Identity carried as salted-hash template (no plaintext)",
          "title": "Phi Free",
          "type": "boolean"
        },
        "has_structured": {
          "default": false,
          "description": "Structured (DOM/a11y) identity present",
          "title": "Has Structured",
          "type": "boolean"
        },
        "has_identifier_crop": {
          "default": false,
          "description": "Pixel identifier crop present",
          "title": "Has Identifier Crop",
          "type": "boolean"
        }
      },
      "title": "IdentityInfo",
      "type": "object"
    },
    "MediaRef": {
      "description": "References to pictures of a step, never the pictures themselves.\n\nEach value is an opaque reference (a bundle-relative path, an asset id)\nthat the surface showing the graph resolves to a URL it has decided is\nsafe to show. The spec never embeds image data.",
      "properties": {
        "crop": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Reference to a crop of the step's target",
          "title": "Crop"
        },
        "frame": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Reference to the full screen at the step",
          "title": "Frame"
        }
      },
      "title": "MediaRef",
      "type": "object"
    },
    "NodeKind": {
      "description": "Kind of graph node.\n\nPhase-2 program states project 1:1 onto the matching kind. A linear bundle\nis all ``action`` nodes plus a trailing ``terminal``. A composition parent\nuses ``child_bundle`` (one node per child) rather than pretending each\nchild is an ``action`` or a ``subflow_call``.",
      "enum": [
        "action",
        "branch",
        "business_decision",
        "loop",
        "subflow_call",
        "child_bundle",
        "terminal"
      ],
      "title": "NodeKind",
      "type": "string"
    },
    "NodeMedia": {
      "description": "Pictures of a step from its recording. Operator-local: the public\nprojection drops it, because a recorded picture can show recorded data.",
      "properties": {
        "recorded": {
          "anyOf": [
            {
              "$ref": "#/$defs/MediaRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "alt": {
          "default": "",
          "description": "Text alternative for the pictures",
          "title": "Alt",
          "type": "string"
        }
      },
      "title": "NodeMedia",
      "type": "object"
    },
    "ParamInfo": {
      "description": "A typed workflow parameter (the run's inputs).",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "type": {
          "default": "string",
          "title": "Type",
          "type": "string"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        },
        "secret": {
          "default": false,
          "title": "Secret",
          "type": "boolean"
        },
        "example": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Example"
        },
        "choices": {
          "items": {
            "type": "string"
          },
          "title": "Choices",
          "type": "array"
        }
      },
      "required": [
        "name"
      ],
      "title": "ParamInfo",
      "type": "object"
    },
    "ProvenanceInfo": {
      "description": "Bundle provenance + certification, projected from the bundle manifest.",
      "properties": {
        "compiler_version": {
          "default": "",
          "title": "Compiler Version",
          "type": "string"
        },
        "certified": {
          "default": false,
          "title": "Certified",
          "type": "boolean"
        },
        "certification_status": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Certification Status"
        },
        "policy_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Policy Name"
        },
        "expires_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expires At"
        },
        "content_digest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Digest"
        },
        "source_recording_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Recording Sha256"
        }
      },
      "title": "ProvenanceInfo",
      "type": "object"
    },
    "ResolutionInfo": {
      "description": "The full resolution ladder for an action node (ordered strongest-first).\n\n``top_rung`` names the strongest rung actually present -- the one the\nruntime prefers -- so a surface can badge \"resolves by DOM selector\" vs\n\"resolves by pixels\" at a glance.",
      "properties": {
        "rungs": {
          "items": {
            "$ref": "#/$defs/ResolutionRung"
          },
          "title": "Rungs",
          "type": "array"
        },
        "top_rung": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Strongest present rung (None if none captured)",
          "title": "Top Rung"
        }
      },
      "title": "ResolutionInfo",
      "type": "object"
    },
    "ResolutionRung": {
      "description": "One rung of the target-resolution ladder for an action node.\n\nThe ladder is consumed strongest-first at replay (structural DOM/UIA ->\ntemplate -> ocr -> landmarks -> grounder), with an optional API tier ABOVE\nthe GUI ladder. ``present`` is whether the compiler captured evidence for\nthis rung; ``detail`` is a short human hint (e.g. the selector, or landmark\ncount).",
      "properties": {
        "name": {
          "description": "Rung id: api|structural|template|ocr|landmarks|grounder",
          "title": "Name",
          "type": "string"
        },
        "label": {
          "description": "Human label for the rung",
          "title": "Label",
          "type": "string"
        },
        "present": {
          "description": "Whether the compiler captured this rung",
          "title": "Present",
          "type": "boolean"
        },
        "detail": {
          "default": "",
          "description": "Short human hint about the evidence",
          "title": "Detail",
          "type": "string"
        }
      },
      "required": [
        "name",
        "label",
        "present"
      ],
      "title": "ResolutionRung",
      "type": "object"
    },
    "SectionKind": {
      "description": "What a section holds: fields to fill, the save, or other steps.",
      "enum": [
        "fields",
        "save",
        "steps"
      ],
      "title": "SectionKind",
      "type": "string"
    },
    "SectionTitleSource": {
      "description": "Where a section's title came from (see :mod:`openadapt_flow.sections`).",
      "enum": [
        "ui",
        "narration",
        "fields",
        "person"
      ],
      "title": "SectionTitleSource",
      "type": "string"
    }
  },
  "description": "The complete, self-describing visualization spec for one compiled bundle.\n\nSerialize with ``spec.model_dump_json()`` (or ``model_dump()``); every\nsurface renders THIS, none re-parse the bundle. See the module docstring.",
  "properties": {
    "spec_version": {
      "default": 2,
      "title": "Spec Version",
      "type": "integer"
    },
    "bundle": {
      "$ref": "#/$defs/BundleMeta"
    },
    "nodes": {
      "items": {
        "$ref": "#/$defs/GraphNode"
      },
      "title": "Nodes",
      "type": "array"
    },
    "edges": {
      "items": {
        "$ref": "#/$defs/GraphEdge"
      },
      "title": "Edges",
      "type": "array"
    },
    "sections": {
      "description": "Named groups of action nodes from the bundle's sections.json",
      "items": {
        "$ref": "#/$defs/GraphSection"
      },
      "title": "Sections",
      "type": "array"
    }
  },
  "required": [
    "bundle"
  ],
  "title": "OpenAdapt Program Graph Spec v2",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openadapt.ai/schemas/program-graph-v2.json"
}
