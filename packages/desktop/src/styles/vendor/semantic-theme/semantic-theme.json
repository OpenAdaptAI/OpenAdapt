{
  "version": 2,
  "source": "The chosen website palette and actions shipped in Home A; colors are unchanged.",
  "roles": {
    "action": "A neutral action is distinct from a verified result.",
    "verified": "Only a saved record confirmed by read-back.",
    "stopped": "A run stopped.",
    "reconcile": "A person must check a possibly changed record.",
    "link": "Navigation, progress and keyboard focus, never verification."
  },
  "themes": {
    "dark": {
      "--oa-text": "#edf1f7",
      "--oa-text-muted": "#9ba7b7",
      "--oa-canvas": "#05080d",
      "--oa-surface": "#0a0f17",
      "--oa-surface-sunken": "#0d141f",
      "--oa-surface-raised": "#0d141f",
      "--oa-border": "#1a2432",
      "--oa-border-strong": "#2a3748",
      "--oa-link": "#79adff",
      "--oa-link-hover": "#a2c6ff",
      "--oa-on-link": "#04101f",
      "--oa-link-tint": "#0c1a2e",
      "--oa-focus": "#a2c6ff",
      "--oa-verified": "#3ad69f",
      "--oa-verified-strong": "#7ae9c0",
      "--oa-verified-tint": "#092a1f",
      "--oa-stopped": "#f5b640",
      "--oa-stopped-strong": "#fcd27a",
      "--oa-stopped-tint": "#2a1d06",
      "--oa-reconcile": "#ff8f86",
      "--oa-glow": "radial-gradient(60% 55% at 50% 0%, rgba(84, 140, 255, 0.22), rgba(84, 140, 255, 0) 70%)",
      "--oa-grid-dot": "rgba(160, 190, 230, 0.10)",
      "--oa-glass": "rgba(13, 20, 31, 0.72)",
      "--oa-shadow-lift": "0 30px 80px -30px rgba(0, 0, 0, 0.8), 0 0 0 1px rgba(255, 255, 255, 0.04) inset",
      "--oa-header-bg": "rgba(5, 8, 13, 0.72)"
    },
    "light": {
      "--oa-text": "#0f1722",
      "--oa-text-muted": "#4f5a67",
      "--oa-canvas": "#ffffff",
      "--oa-surface": "#f5f7fa",
      "--oa-surface-sunken": "#edf2f5",
      "--oa-surface-raised": "#ffffff",
      "--oa-border": "#dde3e9",
      "--oa-border-strong": "#c6d0dc",
      "--oa-link": "#1f4fbf",
      "--oa-link-hover": "#1a43a3",
      "--oa-on-link": "#ffffff",
      "--oa-link-tint": "#eef3fc",
      "--oa-focus": "#1f4fbf",
      "--oa-verified": "#0b7a5a",
      "--oa-verified-strong": "#07553e",
      "--oa-verified-tint": "#e8f3ee",
      "--oa-stopped": "#9a5b0a",
      "--oa-stopped-strong": "#7a4706",
      "--oa-stopped-tint": "#fcf3e6",
      "--oa-reconcile": "#b3261e",
      "--oa-glow": "radial-gradient(60% 55% at 50% 0%, rgba(31, 79, 191, 0.10), rgba(31, 79, 191, 0) 70%)",
      "--oa-grid-dot": "rgba(15, 23, 34, 0.08)",
      "--oa-glass": "rgba(255, 255, 255, 0.78)",
      "--oa-shadow-lift": "0 30px 70px -34px rgba(15, 23, 34, 0.28), 0 0 0 1px rgba(15, 23, 34, 0.04) inset",
      "--oa-header-bg": "rgba(255, 255, 255, 0.8)"
    }
  },
  "common": {
    "--oa-font-body": "\"Public Sans\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif",
    "--oa-font-display": "\"Inter Tight\", var(--oa-font-body)",
    "--oa-font-mono": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace",
    "--oa-action": "var(--oa-text)",
    "--oa-on-action": "var(--oa-canvas)",
    "--oa-action-hover": "color-mix(in srgb, var(--oa-text) 84%, var(--oa-canvas))",
    "--oa-radius-control": "8px",
    "--oa-radius-card": "14px",
    "--oa-radius-action": "9999px",
    "--oa-duration-fast": "150ms",
    "--oa-duration": "200ms",
    "--oa-duration-slow": "250ms",
    "--oa-easing": "cubic-bezier(0.2, 0.7, 0.2, 1)"
  }
}
