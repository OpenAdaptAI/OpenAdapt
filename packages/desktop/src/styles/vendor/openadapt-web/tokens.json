{
    "$schema": "https://openadapt.ai/schemas/design-tokens-1.json",
    "$canonical": "CANONICAL design tokens for all OpenAdapt surfaces. This file is the single source of truth for palette, type scale, spacing, radii, elevation, and motion. Change a value here, regenerate styles/tokens.css, and every surface follows. Do not hand-edit a vendored copy.",
    "$consumers": [
        "openadapt-web (styles/tokens.css, tailwind.config.js)",
        "openadapt-cloud (vendor + hash-check)",
        "openadapt-desktop (vendor + hash-check)",
        "openadapt-ops docs (vendor + hash-check)"
    ],
    "$version": "1.0.0",
    "$notes": {
        "keys": "Every key is the exact CSS custom property name defined in styles/tokens.css. tests/designTokens.test.js fails if the two files disagree.",
        "contrast": "Every text colour meets WCAG AA (4.5:1) against --surface and --surface-raised. tests/linkStyles.test.js measures this from this file.",
        "accent": "One brand accent: --accent-verified. --accent-halt and --accent-danger are reserved for halt and refusal states and must not be used for decoration. --focus-ring is a system affordance, not a brand colour."
    },
    "color": {
        "--ink": "#0B1220",
        "--text-secondary": "#414E63",
        "--text-tertiary": "#5A697F",
        "--surface": "#F5F7FA",
        "--surface-raised": "#FFFFFF",
        "--surface-sunken": "#EDF1F6",
        "--hairline": "#DEE4EC",
        "--hairline-strong": "#C6D0DC",
        "--accent-verified": "#0B7A5A",
        "--accent-verified-hover": "#07553E",
        "--accent-halt": "#9A5B0A",
        "--accent-danger": "#B3261E",
        "--link-visited": "#574FB0",
        "--focus-ring": "#2563EB",
        "--inset-bg": "#0B1220",
        "--inset-raised": "#131C2C",
        "--inset-text": "#E2E8F0",
        "--inset-ok": "#34D399",
        "--inset-warn": "#FBBF24",
        "--inset-border": "#1E293B"
    },
    "font": {
        "--font-display": "'Avenir Next', 'Segoe UI', -apple-system, BlinkMacSystemFont, sans-serif",
        "--font-body": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif",
        "--font-mono": "ui-monospace, SFMono-Regular, 'SF Mono', Menlo, Consolas, monospace"
    },
    "typography": {
        "--text-2xs": "0.6875rem",
        "--text-xs": "0.8125rem",
        "--text-sm": "0.875rem",
        "--text-base": "1rem",
        "--text-lg": "1.25rem",
        "--text-xl": "1.5625rem",
        "--text-2xl": "1.953rem",
        "--text-3xl": "2.441rem",
        "--text-4xl": "3.052rem",
        "--text-5xl": "3.815rem",
        "--leading-tight": "1.12",
        "--leading-snug": "1.3",
        "--leading-body": "1.6",
        "--tracking-tight": "-0.02em",
        "--tracking-wide": "0.14em",
        "--measure": "68ch"
    },
    "space": {
        "--space-1": "0.25rem",
        "--space-2": "0.5rem",
        "--space-3": "0.75rem",
        "--space-4": "1rem",
        "--space-5": "1.5rem",
        "--space-6": "2rem",
        "--space-7": "2.5rem",
        "--space-8": "3rem",
        "--space-9": "4rem",
        "--space-10": "5rem",
        "--space-section": "clamp(4.5rem, 9vw, 7.5rem)"
    },
    "radius": {
        "--radius-sm": "8px",
        "--radius-md": "12px",
        "--radius-lg": "18px",
        "--radius-pill": "9999px"
    },
    "elevation": {
        "--elevation-1": "0 1px 2px rgba(11, 18, 32, 0.05)",
        "--elevation-2": "0 8px 24px rgba(11, 18, 32, 0.07)"
    },
    "motion": {
        "--dur-1": "150ms",
        "--dur-2": "200ms",
        "--dur-3": "250ms",
        "--ease-out": "cubic-bezier(0.2, 0.7, 0.2, 1)"
    }
}
