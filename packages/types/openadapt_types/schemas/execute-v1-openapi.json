            "type": "string"
          }
        },
        "required": [
          "event_id",
          "delivery_attempt",
          "issued_at",
          "issuer_key_id",
          "signature",
          "execution"
        ],
        "title": "ExecuteStateChangedWebhookV1",
        "type": "object"
      },
      "ExecuteStatusV1": {
        "additionalProperties": false,
        "description": "The current public lifecycle view of an execution resource.",
        "properties": {
          "evidence_receipt_id": {
            "anyOf": [
              {
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Evidence Receipt Id"
          },
          "execution_id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$",
            "title": "Execution Id",
            "type": "string"
