{
  "schema_version": "openadapt.plain-outcome-vectors/v1",
  "_about": [
    "Conformance cases for any code that applies outcomes.json. Each case names the merge rule it exercises.",
    "input holds outcome values by source, plus dispatched, delivery_uncertain, and proof when the case sets them.",
    "expect lists the fields the result must have. proof is none unless expect says otherwise.",
    "expect_progress means the run hasn't ended and has no result. expect_error means the input must be refused."
  ],
  "cases": [
    {
      "name": "verified write",
      "rule": "row",
      "input": {
        "transaction_outcome": "VERIFIED",
        "execution_outcome": "VERIFIED"
      },
      "expect": {
        "result": "done",
        "may_have_changed": true,
        "safe_to_retry": false,
        "technical_code": "transaction_outcome=VERIFIED"
      }
    },
    {
      "name": "halt before any write",
      "rule": "row",
      "input": {
        "transaction_outcome": "HALTED_BEFORE_EFFECT",
        "execution_outcome": "HALTED"
      },
      "expect": {
        "result": "stopped_before_change",
        "may_have_changed": false,
        "safe_to_retry": true,
        "technical_code": "transaction_outcome=HALTED_BEFORE_EFFECT"
      }
    },
    {
      "name": "halt after a possible write (the break-it tutorial)",
      "rule": "row",
      "input": {
        "transaction_outcome": "RECONCILIATION_REQUIRED",
