exports[`ProgramWorkbench > matches the rendered map snapshot 1`] = `"<div class="opg-canvas" style="width: 566px; height: 846px;"><svg class="opg-edges" viewBox="0 0 566 846" width="566" height="846" role="img" aria-label="8 compiled program edges"><defs><marker id="opg-arrow-_r_j_" markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto" markerUnits="strokeWidth"><path d="M 0 0 L 8 4 L 0 8 z"></path></marker></defs><g data-kind="loop_body"><path d="M 283 104 C 283 128, 283 128, 283 152" marker-end="url(#opg-arrow-_r_j_)"></path><text x="289" y="131">declared loop</text></g><g data-kind="sequence"><path d="M 283 222 C 283 246, 283 246, 283 270" marker-end="url(#opg-arrow-_r_j_)"></path></g><g data-kind="sequence"><path d="M 283 340 C 283 364, 283 364, 283 388" marker-end="url(#opg-arrow-_r_j_)"></path></g><g data-kind="sequence"><path d="M 283 458 C 283 482, 283 482, 283 506" marker-end="url(#opg-arrow-_r_j_)"></path></g><g data-kind="sequence"><path d="M 283 576 C 283 600, 283 600, 283 624" marker-end="url(#opg-arrow-_r_j_)"></path></g><g data-kind="sequence" data-back-edge="true" data-lane="right"><path d="M 380 659 H 396 Q 402 659 402 653 V 75 Q 402 69 396 69 H 380" marker-end="url(#opg-arrow-_r_j_)"></path></g><g data-kind="sequence" data-lane="left"><path d="M 186 69 H 52 Q 46 69 46 75 V 771 Q 46 777 52 777 H 68" marker-end="url(#opg-arrow-_r_j_)"></path></g><g data-kind="exception"><path d="M 283 694 C 283 718, 401 718, 401 742" marker-end="url(#opg-arrow-_r_j_)"></path><text x="348" y="721">not confirmed</text></g></svg><button type="button" class="opg-node" data-tone="branch" data-selected="true" style="left: 186px; top: 34px; width: 194px; height: 70px;" aria-pressed="true" aria-label="step 01, loop: Repeat the bounded steps." tabindex="0"><span class="opg-node-index">01</span><span class="opg-node-copy"><small>loop</small><strong>Repeat the bounded steps</strong></span><span class="opg-node-signals" aria-hidden="true"></span></button><button type="button" class="opg-node" data-tone="governed" data-fold="folded" style="left: 186px; top: 152px; width: 194px; height: 70px;" aria-pressed="false" aria-label="Steps 02–07, 6 steps: Who: title, first name, last name." tabindex="-1"><span class="opg-node-index">02–07</span><span class="opg-node-copy"><small>6 steps · 3 fields</small><strong title="Who: title, first name, last name">Who: title, first name, last name</strong></span><span class="opg-node-signals" aria-hidden="true"><i title="Checks the right record">R</i></span></button><button type="button" class="opg-node" data-tone="governed" data-fold="folded" style="left: 186px; top: 270px; width: 194px; height: 70px;" aria-pressed="false" aria-label="Steps 08–11, 4 steps: Who: date of birth, sex." tabindex="-1"><span class="opg-node-index">08–11</span><span class="opg-node-copy"><small>4 steps · 2 fields</small><strong title="Who: date of birth, sex">Who: date of birth, sex</strong></span><span class="opg-node-signals" aria-hidden="true"><i title="Checks the right record">R</i></span></button><button type="button" class="opg-node" data-tone="governed" data-fold="folded" style="left: 186px; top: 388px; width: 194px; height: 70px;" aria-pressed="false" aria-label="Steps 12–22, 11 steps: Contact: street, city, state, postal code." tabindex="-1"><span class="opg-node-index">12–22</span><span class="opg-node-copy"><small>11 steps · 4 fields</small><strong title="Contact: street, city, state, postal code">Contact: street, city, state, postal code</strong></span><span class="opg-node-signals" aria-hidden="true"><i title="Checks the right record">R</i></span></button><button type="button" class="opg-node" data-tone="governed" data-fold="folded" style="left: 186px; top: 506px; width: 194px; height: 70px;" aria-pressed="false" aria-label="Steps 23–28, 6 steps: Contact: home phone, email, country." tabindex="-1"><span class="opg-node-index">23–28</span><span class="opg-node-copy"><small>6 steps · 3 fields</small><strong title="Contact: home phone, email, country">Contact: home phone, email, country</strong></span><span class="opg-node-signals" aria-hidden="true"><i title="Checks the right record">R</i></span></button><button type="button" class="opg-node" data-tone="halt" data-fold="folded" style="left: 186px; top: 624px; width: 194px; height: 70px;" aria-pressed="false" aria-label="Steps 29–30, 2 steps: Create New Patient." tabindex="-1"><span class="opg-node-index">29–30</span><span class="opg-node-copy"><small>2 steps · reads the record back</small><strong title="Create New Patient">Create New Patient</strong></span><span class="opg-node-signals" aria-hidden="true"><i title="Checks the right record">R</i><i title="Reads the saved record back">C</i><i title="Stop rules">H</i></span></button><button type="button" class="opg-node" data-tone="terminal" style="left: 68px; top: 742px; width: 194px; height: 70px;" aria-pressed="false" aria-label="end, terminal: End of declared steps." tabindex="-1"><span class="opg-node-index">END</span><span class="opg-node-copy"><small>terminal</small><strong>End of declared steps</strong></span><span class="opg-node-signals" aria-hidden="true"></span></button><button type="button" class="opg-node" data-tone="stop" style="left: 304px; top: 742px; width: 194px; height: 70px;" aria-pressed="false" aria-label="stop, terminal: Stop the run." tabindex="-1"><span class="opg-node-index">STOP</span><span class="opg-node-copy"><small>terminal</small><strong>Stop the run</strong></span><span class="opg-node-signals" aria-hidden="true"></span></button></div>"`;
