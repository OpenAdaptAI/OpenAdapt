{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/OpenAdaptAI/OpenAdapt/blob/main/packages/program-graph/schema/run-trace-v1.json",
  "title": "RunTrace",
  "description": "What one recorded run did, step by step, keyed by program-graph node ids. A trace never carries the values a run typed.",
  "type": "object",
  "required": [
    "trace_version",
    "outcome",
    "events"
  ],
  "properties": {
    "trace_version": {
      "const": 1
    },
    "outcome": {
      "type": "string",
      "description": "completed, halted, or the engine's own outcome word"
    },
    "label": {
      "type": "string"
    },
    "total_ms": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/TraceEvent"
      }
    },
    "receipt": {
      "anyOf": [
        {
          "$ref": "#/$defs/RunReceipt"
        },
        {
          "type": "null"
        }
      ]
    },
    "source": {
      "type": "object",
      "description": "Where the trace came from: files, commits, checksums."
    }
  },
  "$defs": {
    "TraceEvent": {
      "type": "object",
      "required": [
        "node",
        "status"
      ],
      "properties": {
        "node": {
          "type": "string",
          "description": "Program-graph node id the run reached"
        },
        "status": {
          "enum": [
            "ok",
            "halted",
            "skipped",
            "failed"
          ]
        },
        "iteration": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "at_ms": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "duration_ms": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "rung": {
          "type": [
            "string",
            "null"
          ]
        },
        "identity": {
          "enum": [
            "verified",
            "not_verified",
            null
          ]
        },
        "screen_check": {
          "enum": [
            "passed",
            "failed",
            null
          ]
        },
        "effect": {
          "enum": [
            "confirmed",
            "refuted",
            "indeterminate",
            null
          ]
        },
        "effect_checks": {
          "type": [
            "object",
            "null"
          ],
          "required": [
            "confirmed",
            "total"
          ],
          "properties": {
            "confirmed": {
              "type": "integer",
              "minimum": 0
            },
            "total": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "frame": {
          "type": [
            "string",
            "null"
          ],
          "description": "Reference to the screen at this step; resolved by the host, never image data"
        }
      },
      "additionalProperties": false
    },
    "RunReceipt": {
      "type": "object",
      "required": [
        "kind",
        "status",
        "summary"
      ],
      "properties": {
        "kind": {
          "enum": [
            "seal",
            "record"
          ]
        },
        "status": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "href": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
