{
  "name": "@openadapt/program-graph",
  "version": "0.1.0",
  "description": "The OpenAdapt program map: a React view of a compiled program graph, with an optional run trace played over it.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./schema/program-graph-v2.json": "./schema/program-graph-v2.json",
    "./schema/run-trace-v1.json": "./schema/run-trace-v1.json",
    "./fixtures/openemr-referral/spec.json": "./fixtures/openemr-referral/spec.json",
    "./fixtures/openemr-referral/folds.json": "./fixtures/openemr-referral/folds.json",
    "./fixtures/openemr-referral/trace.json": "./fixtures/openemr-referral/trace.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "schema",
    "fixtures",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "vendor": "node scripts/vendor.mjs",
    "demo": "vite --config demo/vite.config.ts"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenAdaptAI/OpenAdapt.git",
    "directory": "packages/program-graph"
  },
  "homepage": "https://github.com/OpenAdaptAI/OpenAdapt/tree/main/packages/program-graph#readme",
  "bugs": "https://github.com/OpenAdaptAI/OpenAdapt/issues",
  "keywords": [
    "openadapt",
    "program-graph",
    "react",
    "visualization"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
